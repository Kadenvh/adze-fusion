*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build / dist outputs (for future prototype)
dist/
build/
*.egg-info/
*.whl

# Local secrets / config
.env
.env.local
*.local.json

# Local agent state
.claude/settings.local.json
.claude/state/
.ava/

# Logs
*.log
logs/

# Temp working files
tmp/
scratch/
